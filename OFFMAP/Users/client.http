@baseUrl = http://127.0.0.1:8000

### ---- GET (Read all users) ----
GET {{baseUrl}}/users/

### ---- GET (Read one user by ID, ผ่าน SQLModel) ----
GET {{baseUrl}}/users/1

### ---- POST (Create) user 1 - Kendall Jenner ----
POST {{baseUrl}}/users/
Content-Type: application/json

{
    "name": "Kendall Jenner",
    "email": "kendall.jenner@example.com",
    "password_hash": "hashed_pw_001",
    "profile_image_url": "https://i.pravatar.cc/300?img=1",
    "nationality": "American",
    "preferred_language": "English",
    "created_at": "2026-08-30T10:00:00",
    "updated_at": "2026-08-30T10:00:00"
}

