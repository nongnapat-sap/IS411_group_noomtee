### ============================================================
### FAVORITE
### ============================================================
### ---- GET: Read all Favorites ----
GET {{baseUrl}}/favorites/

### ---- Create Favorite 7 ----
POST {{baseUrl}}/favorites/
Content-Type: application/json

{
"user_id": 1,
"place_id": 1
}
### ---- Create Favorite 8 ----
POST {{baseUrl}}/favorites/
Content-Type: application/json


{
"user_id": 1,
"place_id": 2
}

### ---- GET: Read Favorite ID 7 ----
GET {{baseUrl}}/favorites/7
### ---- GET: Filter Favorites by User 1 ----
GET {{baseUrl}}/favorites/?user_id=1
### ---- GET: Filter Favorites by Place 2 ----
GET {{baseUrl}}/favorites/?place_id=2
### ---- DELETE: Delete Favorite ID 7 ----
DELETE {{baseUrl}}/favorites/7